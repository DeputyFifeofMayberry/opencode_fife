{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {
    "servers": {
      // Docs lookup for bleeding-edge deps (Effect 4, drizzle rc, TS 7.1).
      // Enabled: connects at startup with the other MCP servers. Works keyless with rate
      // limits; if you have a CONTEXT7_API_KEY, add a Bearer header yourself — missing
      // {env:...} variables substitute an empty string, so never ship one here unconditionally.
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false
      },
      // Live browser DevTools for packages/app + console debugging. Requires a local Chrome install.
      "chrome-devtools": {
        "type": "local",
        "command": ["bunx", "chrome-devtools-mcp@1.10.1"],
        "disabled": true
      }
    }
  },
  "tools": {
    "github-pr-search": false,
  },
  "effort_policy": {
    "verification_commands": ["bun run check"]
  },
  "agents": {
    "build": {
      "description": "Primary coding agent for development work",
      "mode": "primary"
    }
  },
}
