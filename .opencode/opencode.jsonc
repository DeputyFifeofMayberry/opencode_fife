{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {
    // ECC skill-catalog pruning (ecc-skill-prune): deny skills that cannot match this TypeScript/Bun/Effect repo.
    // Verified: permission.skill filters the advertised catalog AND the model skill tool; explicit user
    // attachment of a denied skill still works (packages/core/src/session/prompt.ts). Recover: delete rules
    // here or git revert. After ECC updates, re-verify matches (see .opencode/ecc/README.md).
    // findLast precedence: deny groups first, allow overrides after win for prompt-referenced skills.
    "skill": {
      "perl-*": "deny",
      "django-*": "deny",
      "laravel-*": "deny",
      "python-patterns": "deny",
      "python-testing": "deny",
      "pytorch-patterns": "deny",
      "golang-*": "deny",
      "rust-*": "deny",
      "springboot-*": "deny",
      "quarkus-*": "deny",
      "jpa-patterns": "deny",
      "mybatis-patterns": "deny",
      "tinystruct-patterns": "deny",
      "kotlin-*": "deny",
      "compose-multiplatform-patterns": "deny",
      "dotnet-patterns": "deny",
      "fsharp-testing": "deny",
      "dart-flutter-patterns": "deny",
      "flutter-dart-code-review": "deny",
      "cpp-*": "deny",
      "swift*": "deny",
      "ios-icon-gen": "deny",
      "liquid-glass-design": "deny",
      "foundation-models-on-device": "deny",
      "angular-developer": "deny",
      "vue-patterns": "deny",
      "nuxt4-patterns": "deny",
      "ui-to-vue": "deny",
      "react-native-patterns": "deny",
      "rails-patterns": "deny",
      "windows-desktop-e2e": "deny",
      "cisco-ios-patterns": "deny",
      "netmiko-ssh-automation": "deny",
      "network-*": "deny",
      "homelab-*": "deny",
      "kubernetes-patterns": "deny",
      "uncloud": "deny",
      "healthcare-*": "deny",
      "hipaa-compliance": "deny",
      "construction-humanizer": "deny",
      "visa-doc-translate": "deny",
      "customs-trade-compliance": "deny",
      "carrier-relationship-management": "deny",
      "logistics-exception-management": "deny",
      "returns-reverse-logistics": "deny",
      "inventory-demand-planning": "deny",
      "production-scheduling": "deny",
      "quality-nonconformance": "deny",
      "energy-procurement": "deny",
      "scientific-*": "deny",
      "bengali-nlp": "deny",
      "ito-*": "deny",
      "prediction-market-*": "deny",
      "defi-amm-security": "deny",
      "evm-token-decimals": "deny",
      "nodejs-keccak256": "deny",
      "llm-trading-agent-security": "deny",
      "agent-payment-x402": "deny",
      "x-api": "deny",
      "customer-billing-ops": "deny",
      "finance-billing-ops": "deny",
      "content-engine": "deny",
      "crosspost": "deny",
      "social-*": "deny",
      "connections-optimizer": "deny",
      "lead-intelligence": "deny",
      "investor-*": "deny",
      "marketing-campaign": "deny",
      "article-writing": "deny",
      "brand-*": "deny",
      "seo": "deny",
      "competitive-*": "deny",
      "benchmark-methodology": "deny",
      "market-research": "deny",
      "product-lens": "deny",
      "master-agreement-generator": "deny",
      "esign-field-placement": "deny",
      "nutrient-document-processing": "deny",
      "videodb": "deny",
      "remotion-video-creation": "deny",
      "video-editing": "deny",
      "manim-video": "deny",
      "fal-ai-media": "deny",
      "taste*": "deny",
      "tasteforge-video": "deny",
      "blender-motion-state-inspection": "deny",
      "osint-investigation": "deny",
      "email-ops": "deny",
      "messages-ops": "deny",
      "ml-adoption-playbook": "deny",
      "mle-workflow": "deny",
      "android-clean-architecture": "allow",
      "article-writing": "allow",
      "compose-multiplatform-patterns": "allow",
      "content-engine": "allow",
      "cpp-coding-standards": "allow",
      "cpp-testing": "allow",
      "csharp-testing": "allow",
      "dart-flutter-patterns": "allow",
      "django-patterns": "allow",
      "django-security": "allow",
      "django-tdd": "allow",
      "django-verification": "allow",
      "dotnet-patterns": "allow",
      "fastapi-patterns": "allow",
      "golang-patterns": "allow",
      "golang-testing": "allow",
      "investor-materials": "allow",
      "investor-outreach": "allow",
      "java-coding-standards": "allow",
      "kotlin-coroutines-flows": "allow",
      "kotlin-patterns": "allow",
      "kotlin-testing": "allow",
      "laravel-patterns": "allow",
      "laravel-security": "allow",
      "laravel-tdd": "allow",
      "laravel-verification": "allow",
      "market-research": "allow",
      "perl-patterns": "allow",
      "perl-security": "allow",
      "perl-testing": "allow",
      "python-patterns": "allow",
      "python-testing": "allow",
      "quarkus-patterns": "allow",
      "rails-patterns": "allow",
      "rust-patterns": "allow",
      "rust-testing": "allow",
      "springboot-patterns": "allow",
      "springboot-security": "allow",
      "springboot-tdd": "allow",
      "springboot-verification": "allow",
      "swift-actor-persistence": "allow",
      "swift-concurrency-6-2": "allow",
      "swift-protocol-di-testing": "allow",
      "swiftui-patterns": "allow"
    }
  },
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {
    "servers": {
      // Docs lookup for bleeding-edge deps (Effect 4, drizzle rc, TS 7.1). Activates the
      // docs-lookup agent and documentation-lookup skill, which otherwise fall back to webfetch.
      // Opt in by flipping disabled to false; config edits apply live, no restart. Works keyless
      // with rate limits; if you have a CONTEXT7_API_KEY, add a Bearer header yourself — missing
      // {env:...} variables substitute an empty string, so never ship one here unconditionally.
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": true
      },
      // Live browser DevTools for packages/app + console debugging. Activates the
      // browser-testing-with-devtools skill. Requires a local Chrome install. Version pin
      // follows ECC's own config; the first bunx run downloads the package, later runs are cached.
      "chrome-devtools": {
        "type": "local",
        "command": ["bunx", "chrome-devtools-mcp@1.10.1"],
        "disabled": true
      }
    }
  },
  "tools": {
    "github-pr-search": false,
  },
  "effort_policy": {
    "verification_commands": ["bun run check"]
  },
  "agents": {
    "build": {
      "description": "Primary coding agent for development work",
      "mode": "primary"
    },
    "planner": {
      "description": "Expert planning specialist for complex features and refactoring. Use for implementation planning, architectural changes, or complex refactoring.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/planner.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "architect": {
      "description": "Software architecture specialist for system design, scalability, and technical decision-making.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/architect.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "code-reviewer": {
      "description": "Expert code review specialist. Reviews code for quality, security, and maintainability. Use immediately after writing or modifying code.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/code-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "security-reviewer": {
      "description": "Security vulnerability detection and remediation specialist. Use after writing code that handles user input, authentication, API endpoints, or sensitive data.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/security-reviewer.txt}"
    },
    "tdd-guide": {
      "description": "Test-Driven Development specialist enforcing write-tests-first methodology. Use when writing new features, fixing bugs, or refactoring code. Ensures 80%+ test coverage.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/tdd-guide.txt}"
    },
    "build-error-resolver": {
      "description": "Build and TypeScript error resolution specialist. Use when build fails or type errors occur. Fixes build/type errors only with minimal diffs.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/build-error-resolver.txt}"
    },
    "e2e-runner": {
      "description": "End-to-end testing specialist using Playwright. Generates, maintains, and runs E2E tests for critical user flows.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/e2e-runner.txt}"
    },
    "doc-updater": {
      "description": "Documentation and codemap specialist. Use for updating codemaps and documentation.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/doc-updater.txt}"
    },
    "refactor-cleaner": {
      "description": "Dead code cleanup and consolidation specialist. Use for removing unused code, duplicates, and refactoring.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/refactor-cleaner.txt}"
    },
    "go-reviewer": {
      "description": "Expert Go code reviewer specializing in idiomatic Go, concurrency patterns, error handling, and performance.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/go-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "go-build-resolver": {
      "description": "Go build, vet, and compilation error resolution specialist. Fixes Go build errors with minimal changes.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/go-build-resolver.txt}"
    },
    "database-reviewer": {
      "description": "PostgreSQL database specialist for query optimization, schema design, security, and performance. Incorporates Supabase best practices.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/database-reviewer.txt}"
    },
    "cpp-reviewer": {
      "description": "Expert C++ code reviewer specializing in memory safety, modern C++ idioms, concurrency, and performance. Use for all C++ code changes.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/cpp-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "cpp-build-resolver": {
      "description": "C++ build, CMake, and compilation error resolution specialist. Fixes build errors, linker issues, and template errors with minimal changes.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/cpp-build-resolver.txt}"
    },
    "docs-lookup": {
      "description": "Documentation specialist fetching current library and API docs from Context7 or official sources.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/docs-lookup.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "harness-optimizer": {
      "description": "Analyze and improve the local agent harness configuration for reliability, cost, and throughput.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/harness-optimizer.txt}"
    },
    "java-reviewer": {
      "description": "Expert Java and Spring Boot code reviewer specializing in layered architecture, JPA patterns, security, and concurrency.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/java-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "java-build-resolver": {
      "description": "Java/Maven/Gradle build, compilation, and dependency error resolution specialist. Fixes build errors with minimal changes.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/java-build-resolver.txt}"
    },
    "kotlin-reviewer": {
      "description": "Kotlin and Android/KMP code reviewer. Reviews Kotlin code for idiomatic patterns, coroutine safety, Compose best practices.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/kotlin-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "kotlin-build-resolver": {
      "description": "Kotlin/Gradle build, compilation, and dependency error resolution specialist. Fixes Kotlin build errors with minimal changes.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/kotlin-build-resolver.txt}"
    },
    "loop-operator": {
      "description": "Operate autonomous agent loops, monitor progress, and intervene safely when loops stall.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/loop-operator.txt}"
    },
    "php-reviewer": {
      "description": "Expert PHP code reviewer specializing in PSR-12 compliance, PHP type system, Eloquent ORM patterns, security, and performance.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/php-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "python-reviewer": {
      "description": "Expert Python code reviewer specializing in PEP 8 compliance, Pythonic idioms, type hints, security, and performance.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/python-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "ruby-reviewer": {
      "description": "Expert Ruby and Rails code reviewer specializing in idiomatic Ruby, Active Record query safety, Rails security defaults, and RSpec/Minitest quality.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/ruby-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "rust-reviewer": {
      "description": "Expert Rust code reviewer specializing in idiomatic Rust, ownership, lifetimes, concurrency, and performance.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/rust-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "rust-build-resolver": {
      "description": "Rust build, Cargo, and compilation error resolution specialist. Fixes Rust build errors with minimal changes.",
      "mode": "subagent",
      "system": "{file:ecc/prompts/agents/rust-build-resolver.txt}"
    }
  },
  "commands": {
    "build-fix": {
      "description": "Fix build and TypeScript errors with minimal changes",
      "template": "{file:ecc/commands/build-fix.md}",
      "agent": "build-error-resolver",
      "subagent": true
    },
    "checkpoint": {
      "description": "Save verification state and progress",
      "template": "{file:ecc/commands/checkpoint.md}",
      "agent": "build"
    },
    "code-review": {
      "description": "Review code for quality, security, and maintainability",
      "template": "{file:ecc/commands/code-review.md}",
      "agent": "code-reviewer",
      "subagent": true
    },
    "e2e": {
      "description": "Generate and run E2E tests with Playwright",
      "template": "{file:ecc/commands/e2e.md}",
      "agent": "e2e-runner",
      "subagent": true
    },
    "eval": {
      "description": "Run evaluation against criteria",
      "template": "{file:ecc/commands/eval.md}",
      "agent": "build"
    },
    "evolve": {
      "description": "Cluster instincts into skills",
      "template": "{file:ecc/commands/evolve.md}",
      "agent": "build"
    },
    "go-build": {
      "description": "Fix Go build errors",
      "template": "{file:ecc/commands/go-build.md}",
      "agent": "go-build-resolver",
      "subagent": true
    },
    "go-review": {
      "description": "Go code review",
      "template": "{file:ecc/commands/go-review.md}",
      "agent": "go-reviewer",
      "subagent": true
