{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "saintsBlack": "#101820",
    "saintsInk0": "#0d1218",
    "saintsInk1": "#151c24",
    "saintsInk2": "#1d2630",
    "saintsInk3": "#2a3644",
    "oldGold": "#d3bc8d",
    "fleurGold": "#f0dca8",
    "goldAmber": "#e0a852",
    "mardiPurple": "#a78bd6",
    "mardiGreen": "#6fc08a",
    "mardiSage": "#8fb8a8",
    "inkText": "#f1e9d9",
    "inkTextDim": "#9c9482",
    "inkFaint": "#6e6758",
    "goldDeep": "#8a6d1f",
    "goldBronze": "#7a5e14",
    "mardiPurpleDeep": "#5b3e91",
    "mardiGreenDeep": "#1f7a46",
    "parchment": "#f6f1e6",
    "parchmentPanel": "#efe8d8",
    "parchmentElement": "#e4dbc7",
    "parchmentBorder": "#c6bba1",
    "parchmentBorderSubtle": "#ddd3be",
    "nightText": "#1b1e23",
    "nightTextDim": "#6b6555",
    "nightFaint": "#8a8371",
    "nightPunctuation": "#46413a"
  },
  "theme": {
    "primary": { "dark": "oldGold", "light": "goldDeep" },
    "secondary": { "dark": "oldGold", "light": "goldDeep" },
    "accent": { "dark": "fleurGold", "light": "goldBronze" },
    "error": { "dark": "#e05b5b", "light": "#b23a3a" },
    "warning": { "dark": "#e2c25c", "light": "#8a6900" },
    "success": { "dark": "#5cbe7a", "light": "mardiGreenDeep" },
    "info": { "dark": "#6f97c6", "light": "#3d6a9e" },
    "text": { "dark": "inkText", "light": "nightText" },
    "textMuted": { "dark": "inkTextDim", "light": "nightTextDim" },
    "background": { "dark": "saintsInk0", "light": "parchment" },
    "backgroundPanel": { "dark": "saintsInk1", "light": "parchmentPanel" },
    "backgroundElement": { "dark": "saintsInk2", "light": "parchmentElement" },
    "border": { "dark": "saintsInk3", "light": "parchmentBorder" },
    "borderActive": { "dark": "oldGold", "light": "goldDeep" },
    "borderSubtle": { "dark": "saintsInk2", "light": "parchmentBorderSubtle" },
    "diffAdded": { "dark": "#56a96e", "light": "mardiGreenDeep" },
    "diffRemoved": { "dark": "#de6262", "light": "#b23a3a" },
    "diffContext": { "dark": "inkTextDim", "light": "nightTextDim" },
    "diffHunkHeader": { "dark": "#6f97c6", "light": "#3d6a9e" },
    "diffHighlightAdded": { "dark": "#86d99a", "light": "#0f8a4d" },
    "diffHighlightRemoved": { "dark": "#f08b8b", "light": "#d84545" },
    "diffAddedBg": { "dark": "#12241a", "light": "#e1efe3" },
    "diffRemovedBg": { "dark": "#291417", "light": "#f5e0e0" },
    "diffContextBg": { "dark": "saintsInk1", "light": "parchmentPanel" },
    "diffLineNumber": { "dark": "inkFaint", "light": "nightFaint" },
    "diffAddedLineNumberBg": { "dark": "#0f1c14", "light": "#d6e7d6" },
    "diffRemovedLineNumberBg": { "dark": "#211316", "light": "#efd6d6" },
    "markdownText": { "dark": "inkText", "light": "nightText" },
    "markdownHeading": { "dark": "fleurGold", "light": "goldDeep" },
    "markdownLink": { "dark": "#7fa6d4", "light": "#3d6a9e" },
    "markdownLinkText": { "dark": "#a5c4e4", "light": "#2c5580" },
    "markdownCode": { "dark": "mardiGreen", "light": "mardiGreenDeep" },
    "markdownBlockQuote": { "dark": "inkTextDim", "light": "nightTextDim" },
    "markdownEmph": { "dark": "oldGold", "light": "goldDeep" },
    "markdownStrong": { "dark": "fleurGold", "light": "goldBronze" },
    "markdownHorizontalRule": { "dark": "inkFaint", "light": "nightFaint" },
    "markdownListItem": { "dark": "#7fa6d4", "light": "#3d6a9e" },
    "markdownListEnumeration": { "dark": "mardiPurple", "light": "mardiPurpleDeep" },
    "markdownImage": { "dark": "#7fa6d4", "light": "#3d6a9e" },
    "markdownImageText": { "dark": "#a5c4e4", "light": "#2c5580" },
    "markdownCodeBlock": { "dark": "inkText", "light": "nightText" },
    "syntaxComment": { "dark": "inkFaint", "light": "#7a7565" },
    "syntaxKeyword": { "dark": "mardiPurple", "light": "mardiPurpleDeep" },
    "syntaxFunction": { "dark": "fleurGold", "light": "goldBronze" },
    "syntaxVariable": { "dark": "inkText", "light": "nightText" },
    "syntaxString": { "dark": "mardiGreen", "light": "mardiGreenDeep" },
    "syntaxNumber": { "dark": "goldAmber", "light": "#95560a" },
    "syntaxType": { "dark": "oldGold", "light": "goldDeep" },
    "syntaxOperator": { "dark": "mardiSage", "light": "#2e6b58" },
    "syntaxPunctuation": { "dark": "#bcb29e", "light": "nightPunctuation" }
  }
}
