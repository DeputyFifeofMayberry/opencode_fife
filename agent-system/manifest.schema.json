{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode.ai/agent-system/manifest.schema.json",
  "title": "Agent system manifest",
  "description": "Install contract for the managed SDD roles, skills, and tier configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "agentSystemVersion", "roleContentVersion", "plugin", "lineEndings", "files"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "agentSystemVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "roleContentVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "plugin": {
      "type": "string",
      "pattern": "^opencode-model-router@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "lineEndings": {
      "type": "string",
      "enum": ["lf"]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "source", "target", "scope", "sha256"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["agent", "skill", "config"]
          },
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]+$"
          },
          "source": {
            "type": "string",
            "pattern": "^(\\.opencode|agent-system)/"
          },
          "target": {
            "type": ["string", "null"]
          },
          "scope": {
            "type": "string",
            "enum": ["global", "project", "config"]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
